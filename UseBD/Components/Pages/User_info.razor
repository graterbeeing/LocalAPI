@page "/user_info"
@inject HttpClient Http
@inject NavigationManager Navigation
@using UseBD.Model
@using UseBD.Services
@inject User_service User_service
@using ClassLibrary

<div class="container" style="width:320px">

    <!-- Username Form -->
    <form @onsubmit="HandleNameSubmit">
        <div class="row mb-3">
            <div class="col-12 text-center">
                <p><strong>Current Name:</strong> @currentName</p>
                <input type="text" @bind="newName" placeholder="Enter new name" class="form-control" required />
                <button class="btn btn-primary mt-2" type="submit" style="height:50px; width:150px;">
                    Change Name
                </button>
                <label>@messege</label>
            </div>
        </div>
    </form>

    <!-- Email Form -->
    <form @onsubmit="HandleEmailSubmit">
        <div class="row mb-3">
            <div class="col-12 text-center">
                <input type="email" @bind="newEmail" placeholder="Enter new email" class="form-control" required />
                <button class="btn btn-primary mt-2" type="submit" style="height:50px; width:150px;">
                    Change Email
                </button>
                <label>@emailMessage</label>
            </div>
        </div>
    </form>

</div>

@code {
    private string currentName = "";
    private string newName = "";
    private string messege = "";

    private string newEmail = "";
    private string emailMessage = "";

    protected override async Task OnInitializedAsync()
    {
        currentName = User_service.UserName;
    }

    private async Task HandleNameSubmit()
    {
        var url = $"http://localhost:5210/api/User/update_username/{User_service.UserId}/{currentName}/{newName}";
        var response = await Http.PutAsync(url, null);

        messege = response.IsSuccessStatusCode ? "Username changed successfully." : "Username already in use.";
        User_service.UserName = newName;
    }

    private async Task HandleEmailSubmit()
    {
        var url = $"http://localhost:5210/api/User/Update_Email/{User_service.UserId}/{newEmail}";
        var response = await Http.PutAsync(url, null);

        emailMessage = response.IsSuccessStatusCode ? "Email updated successfully." : "Failed to update email.";
    }
}
