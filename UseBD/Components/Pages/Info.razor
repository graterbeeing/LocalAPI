@page "/user"
@inject HttpClient Http
@using UseBD.Model;
@using UseBD.Services;
@inject User_service User_service;
@using ClassLibrary;
@inject NavigationManager NavigationManager;


<div class="container" style="width:320px">
    <div class="row" style="height:110px">
        <div class="col-md-6">
            <button @onclick="Exit" type="button" class="button" style="height:100px;width:150px">
                <i class="bi bi-person-circle"></i> Change details
            </button>
        </div>
        <div class="col-md-6">
            <button @onclick="Featured" type="button" class="button" style="height:100px;width:150px">
                <i class="bi bi-person-circle"></i> Featured
            </button>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <button @onclick="Browse" type="button" class="button" style="height:100px;width:150px">
                <i class="bi bi-person-circle"></i> Browse
            </button>
        </div>
        <div class="col-md-6">
            <button @onclick="Portfolio" type="button" class="button" style="height:100px;width:150px">
                <i class="bi bi-person-circle"></i> Portfolio
            </button>
        </div>
    </div>
</div>

@if (admin)
{
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 50vh;">
        @* Center vertically *@
        <div class="d-flex flex-row">
            @* Vertical layout *@
            
            <button @onclick="Investment" type="button" class="button" style="height:100px;width:150px;margin:20px">
                <i class="bi bi-person-circle"></i> manage investments
            </button>
            <button @onclick="Options" type="button" class="button" style="height:100px;width:150px;margin:20px">
                @* No margin on last button *@
                <i class="bi bi-person-circle"></i> create/delete stocks
            </button>
        </div>
    </div>
}


@code {
    private bool admin;

    protected override void OnInitialized()
    {
        admin = User_service.Role == 1;
        base.OnInitialized();
    }

    // navigations

    /*
     * <button type="button" class="button" style="height:100px;width:150px;margin:20px">
                @* Add margin bottom *@
                <i class="bi bi-person-circle"></i> manage users
            </button>
     */

    protected async Task Investment()
    {
        NavigationManager.NavigateTo("/add_inv");
    }

    protected async Task Options()
    {
        NavigationManager.NavigateTo("/option-manager");
    }

    protected async Task Featured()
    {
        NavigationManager.NavigateTo("/Main_page");
    }

    protected async Task Browse()
    {
        NavigationManager.NavigateTo("/Inv_list");
    }

    protected async Task Portfolio()
    {
        NavigationManager.NavigateTo("/portfolio");
    }

    protected async Task Exit()
    {
        NavigationManager.NavigateTo("/user_info");
    }
}