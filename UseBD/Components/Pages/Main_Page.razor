@page "/Main_page"
@using ClassLibrary;
@using UseBD.Services;
@inject User_service User_service;
@inject HttpClient Http;
@inject NavigationManager NavigationManager;
@using System.Collections.Generic;
@using System.Linq;
@using BlazorBootstrap;

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-4">
            <div class="dropdown">
                <input type="text"
                       class="form-control dropdown-toggle"
                       @bind="searchTerm"
                       @oninput="OnSearchInput"
                       @onfocus="ShowDropdown"
                       @onblur="HideDropdownDelayed"
                       placeholder="Search stocks..."
                       autocomplete="off"
                       readonly="@isLoadingStocks" />

                @if (showDropdown && filteredStocks.Any())
                {
                    <div class="dropdown-menu show" style="max-height: 200px; overflow-y: auto; width: 100%;">
                        @foreach (var stock in filteredStocks.Take(10))
                        {
                            <a class="dropdown-item"
                               href="#"
                               @onmousedown="@(() => SelectStock(stock))"
                               @onmousedown:preventDefault="true">
                                <strong>@stock.Symbol</strong>
                            </a>
                        }
                        @if (filteredStocks.Count > 10)
                        {
                            <div class="dropdown-item-text text-muted small">
                                ... and @(filteredStocks.Count - 10) more results
                            </div>
                        }
                    </div>
                }

                @if (isLoadingStocks)
                {
                    <div class="dropdown-menu show">
                        <div class="dropdown-item-text">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                            Loading stocks...
                        </div>
                    </div>
                }

                @if (!isLoadingStocks && !string.IsNullOrEmpty(searchTerm) && !filteredStocks.Any())
                {
                    <div class="dropdown-menu show">
                        <div class="dropdown-item-text text-muted">
                            No stocks found matching "@searchTerm"
                        </div>
                    </div>
                }
            </div>

            @if (selectedStockInfo != null)
            {
                <small class="text-muted">Selected: @selectedStockInfo.Symbol</small>
            }
        </div>
        <div class="col-md-4">
            <select class="form-select" @bind="selectedDays">
                <option value="7">Last 7 days</option>
                <option value="14">Last 14 days</option>
                <option value="30">Last 30 days</option>
                <option value="90">Last 90 days</option>
            </select>
        </div>
        <div class="col-md-4">
            <button class="btn btn-primary" @onclick="HandleUpdateButtonClick" disabled="@(isLoading || selectedStockInfo == null)">
                @if (isLoading)
                {
                    <span>Loading...</span>
                }
                else
                {
                    <span>Update Chart</span>
                }
            </button>
        </div>
    </div>

    <div style="height: 400px;" class="overflow-auto">
        @if (shouldRenderChart)
        {
            <LineChart @ref="lineChart" Width="800" />
        }
        else
        {
            <div class="d-flex justify-content-center align-items-center h-100">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-info") mt-3">
        @message
    </div>
}

@code {
    // Chart related properties
    private LineChart lineChart = default!;
    private LineChartOptions lineChartOptions = default!;
    private ChartData chartData = default!;
    private YQuotesControl stock = new YQuotesControl();
    private List<double> prices = new List<double>();
    private string message = "";
    private bool isError = false;
    private int selectedDays = 20;
    private bool shouldRenderChart = false;
    private bool isLoading = false;
    private int chartUpdateVersion = 0;

    // Stock search related properties
    private List<OptionsData> allStocks = new List<OptionsData>();
    private List<OptionsData> filteredStocks = new List<OptionsData>();
    private OptionsData? selectedStockInfo = null;
    private string searchTerm = "";
    private bool showDropdown = false;
    private bool isLoadingStocks = false;
    private Timer? hideDropdownTimer;


    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableStocksAsync();

        // Set default selection to Tesla if available
        var defaultStock = allStocks.FirstOrDefault(s => s.Symbol == "TSLA") ?? allStocks.FirstOrDefault();
        if (defaultStock != null)
        {
            selectedStockInfo = defaultStock;
            searchTerm = $"{defaultStock.Symbol}";
            await LoadStockDataAsync();
        }
    }

    private async Task LoadAvailableStocksAsync()
    {
        try
        {
            isLoadingStocks = true;
            StateHasChanged();

            // Replace this URL with your actual API endpoint
            var response = await Http.GetFromJsonAsync<List<OptionsData>>($"http://localhost:5210/api/Options/SearchLikeSymbol/{""}");

            if (response != null)
            {
                allStocks = response.OrderBy(s => s.Symbol).ToList();
                filteredStocks = allStocks.ToList();
            }
            else
            {
                // Fallback to hardcoded stocks if API fails
                allStocks = new List<OptionsData>
                {
                    new OptionsData { Symbol = "TSLA" },
                    new OptionsData { Symbol = "MSFT" },
                    new OptionsData { Symbol = "AAPL"},
                    new OptionsData { Symbol = "GOOGL" },
                    new OptionsData { Symbol = "AMZN" },
                    new OptionsData { Symbol = "META" },
                    new OptionsData { Symbol = "NVDA" }
                };
                filteredStocks = allStocks.ToList();
            }
        }
        catch (Exception ex)
        {
            //directed here 
            Console.WriteLine($"Error loading stocks: {ex.Message}");

            // Fallback to hardcoded stocks
            allStocks = new List<OptionsData>
            {
                new OptionsData { Symbol = "TSLA" },
                new OptionsData { Symbol = "MSFT" },
                new OptionsData { Symbol = "AAPL" },
                new OptionsData { Symbol = "GOOGL" },
                new OptionsData { Symbol = "AMZN" },
                new OptionsData { Symbol = "META" }
            };
            filteredStocks = allStocks.ToList();
        }
        finally
        {
            isLoadingStocks = false;
            StateHasChanged();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        FilterStocks();
        showDropdown = true;
    }

    private void FilterStocks()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredStocks = allStocks.ToList();
        }
        else
        {
            var searchLower = searchTerm.ToLower();
            filteredStocks = allStocks.Where(s =>
                s.Symbol.ToLower().Contains(searchLower)
            ).ToList();
        }
        StateHasChanged();
    }

    private void ShowDropdown()
    {
        hideDropdownTimer?.Dispose();
        showDropdown = true;
        FilterStocks();
    }

    private void HideDropdownDelayed()
    {
        hideDropdownTimer?.Dispose();
        hideDropdownTimer = new Timer((_) =>
        {
            InvokeAsync(() =>
            {
                showDropdown = false;
                StateHasChanged();
            });
        }, null, 200, Timeout.Infinite);
    }

    private void SelectStock(OptionsData stockInfo)
    {
        selectedStockInfo = stockInfo;
        searchTerm = $"{stockInfo.Symbol}";
        showDropdown = false;
        StateHasChanged();
    }

    private async Task HandleUpdateButtonClick()
    {
        if (isLoading || selectedStockInfo == null) return;

        chartUpdateVersion++; // Increment version to force refresh
        await LoadStockDataAsync();
    }

    private async Task LoadStockDataAsync()
    {
        if (selectedStockInfo == null) return;

        int currentVersion = chartUpdateVersion;

        try
        {
            isLoading = true;
            isError = false;
            message = $"Loading {selectedStockInfo.Symbol} data for the last {selectedDays} days...";

            // Remove chart from DOM
            shouldRenderChart = false;
            StateHasChanged();

            // Longer delay to ensure DOM updates completely
            await Task.Delay(200);

            // Check if we're still working on the latest request
            if (currentVersion != chartUpdateVersion) return;

            DateTime start = DateTime.Now.AddDays(-selectedDays);
            prices = await stock.GetHistoricalClosingPricesAsync(selectedStockInfo.Symbol, start);

            if (prices == null || prices.Count == 0)
            {
                isError = true;
                message = $"No historical data found for {selectedStockInfo.Symbol} in the last {selectedDays} days.";
                StateHasChanged();
                isLoading = false;
                return;
            }

            // Generate appropriate date labels
            var labels = GenerateDateLabels(start, prices.Count);

            var colors = ColorUtility.CategoricalTwelveColors;
            var datasets = new List<IChartDataset>();

            var dataset1 = new LineChartDataset
            {
                Label = selectedStockInfo.Symbol,
                Data = prices.Select(p => (double?)p).ToList(),
                BackgroundColor = colors[0],
                BorderColor = colors[0],
                BorderWidth = 2,
                HoverBorderWidth = 4,
                // PointRadius and PointHoverRadius commented out as they caused issues
            };

            datasets.Add(dataset1);
            chartData = new ChartData { Labels = labels, Datasets = datasets };

            // Configure chart options
            lineChartOptions = new LineChartOptions
            {
                Responsive = true,
                Interaction = new Interaction { Mode = InteractionMode.Index }
            };

            // Configure axes
            lineChartOptions.Scales.X!.Title = new ChartAxesTitle { Text = "Date", Display = true };
            lineChartOptions.Scales.Y!.Title = new ChartAxesTitle { Text = "Price ($)", Display = true };

            // Set Y-axis min with 5% padding
            double minPrice = prices.Min();
            double maxPrice = prices.Max();
            double padding = (maxPrice - minPrice) * 0.1;
            lineChartOptions.Scales.Y!.Min = Math.Max(0, minPrice - padding);
            lineChartOptions.Scales.Y!.Max = maxPrice + padding;

            // Set chart title
            lineChartOptions.Plugins.Title!.Text = $"{selectedStockInfo.Symbol} Stock Price - Last {selectedDays} Days";
            lineChartOptions.Plugins.Title.Display = true;

            message = "";

            // Re-add chart to DOM
            shouldRenderChart = true;
            StateHasChanged();

            // Allow time for chart component to render before initializing
            await Task.Delay(100);

            // Check if we're still on the latest request
            if (currentVersion != chartUpdateVersion) return;

            if (lineChart != null)
            {
                await lineChart.InitializeAsync(chartData, lineChartOptions);
            }
        }
        catch (Exception ex)
        {
            if (currentVersion == chartUpdateVersion) // Only update UI if this is still the current request
            {
                isError = true;
                message = $"Error loading chart data: {ex.Message}";
                Console.WriteLine($"Error: {ex}");
                StateHasChanged();
            }
        }
        finally
        {
            if (currentVersion == chartUpdateVersion) // Only update loading state if this is still the current request
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private List<string> GenerateDateLabels(DateTime startDate, int dataPointCount)
    {
        var labels = new List<string>();

        // Different labeling strategies based on the number of days
        if (selectedDays <= 14)
        {
            // Show each day for shorter periods
            for (int i = 0; i < dataPointCount; i++)
            {
                labels.Add(startDate.AddDays(i).ToString("MM/dd"));
            }
        }
        else if (selectedDays <= 30)
        {
            // Show every other day for medium periods
            int interval = Math.Max(1, dataPointCount / 10);
            for (int i = 0; i < dataPointCount; i++)
            {
                if (i % interval == 0 || i == dataPointCount - 1)
                {
                    labels.Add(startDate.AddDays(i).ToString("MM/dd"));
                }
                else
                {
                    labels.Add("");
                }
            }
        }
        else
        {
            // Show weekly markers for longer periods
            int interval = Math.Max(1, dataPointCount / 8);
            for (int i = 0; i < dataPointCount; i++)
            {
                if (i % interval == 0 || i == dataPointCount - 1)
                {
                    labels.Add(startDate.AddDays(i).ToString("MM/dd"));
                }
                else
                {
                    labels.Add("");
                }
            }
        }

        return labels;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // No need to do anything in first render as LoadStockDataAsync handles it
        }
    }

    public void Dispose()
    {
        hideDropdownTimer?.Dispose();
    }
}